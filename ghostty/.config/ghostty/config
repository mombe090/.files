theme = "Catppuccin Macchiato"

# Font -- use FAMILY names (see `ghostty +list-fonts`), not style names.
# Keep one family for regular/bold/italic unless you really want mixing.
font-family = "CaskaydiaMono Nerd Font Mono"
font-size = 18

mouse-hide-while-typing = true
copy-on-select = true

# window-decoration = true

macos-option-as-alt = true
macos-icon = "official"

# Hide macOS window buttons (traffic lights: close/minimize/maximize)
macos-window-buttons = hidden

background-opacity = 1

# In Ghostty 1.3+ the key is `background-blur`, NOT `background-blur-radius`
# (your old `background-blur-radius = 0` was silently ignored).
# true = 20, or set an int, or macos-glass-regular / macos-glass-clear on macOS 26+
background-blur = true

shell-integration = "zsh"

# show keybiding ghostty +list-keybinds --default

# Linux-only (Hyprland fix). Breaks/ignored on macOS where backend is kqueue, so keep disabled here.
# async-backend = epoll
